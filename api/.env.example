# Variables lues par ffe.config (préfixe FFE_). Aucune n'est obligatoire ; ce fichier n'est jamais chargé
# automatiquement : il documente les noms (maître : docs/ARCHITECTURE.md §1).
FFE_ENV=dev                      # dev (~/.persist/ffe-dev) | prod (~/.persist/ffe) ; `ffe serve --prod` force prod
FFE_DATA_DIR=                    # surcharge du dossier de données ; refusé hors ext4
FFE_BACKUP_DIR=/workspaces/Perso/FFE-sauvegardes
FFE_HOST=127.0.0.1
FFE_PORT=8000
FFE_WEB_DIST=                    # dossier statique servi en usage réel (défaut : ../web/dist)
FFE_DEV_CONTACTS_CSV=            # dev seulement : annuaire réimporté par `ffe db reset-dev` (défaut : references/ANNUAIRE FUSION.csv, ignoré si absent)
